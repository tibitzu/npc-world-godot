; Engine configuration file.
config_version=5

[application]

config/name="npc-world"
config/description="A shared town of residents who live their own lives until a player takes one over."
run/main_scene="res://scenes/world/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://autoload/game.gd"
Events="*res://autoload/events.gd"
Registry="*res://autoload/registry.gd"
Net="*res://autoload/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

