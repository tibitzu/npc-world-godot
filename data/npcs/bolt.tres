lines = PackedStringArray("Parcel for... nobody. Again.", "Fastest route across town: straight through the square.", "Ran every lap of this place before breakfast.", "Edge of the world's right there. I check it hourly.", "Gotta keep moving.", "Seventy metres of road and not one parcel.", "The tavern is my last stop. Every day.", "Bolt Post: open whenever I'm not running.", "Somebody keeps stacking parcels by my door. It's me.")
sleep_hour = 23.0
wake_hour = 6.0
bed_lines = PackedStringArray("Last delivery of the day: me, to bed.", "Clocking off. See you at first light.")
wake_lines = PackedStringArray("Rise and run!", "Morning route starts now.")
greet_lines = PackedStringArray("Yo, {n}!", "Coming through, {n}!", "{n}! Anything to deliver?")
reply_lines = PackedStringArray("Heard. Gotta run.", "Cool cool cool.", "Noted!", "Sure thing.")
answer_lines = PackedStringArray("No idea, I just carry things.", "Ask me later, I'm on a route.", "Probably? Maybe. Gotta go.")
