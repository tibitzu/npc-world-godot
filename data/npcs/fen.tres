wander_range = 4.0
home_radius = 10.0
lines = PackedStringArray("Dusk again. It's always dusk.", "That lamp has burned a thousand ticks.", "In my day the roads were all mud.", "Mind the edges, young ones.", "Hm. Hmmm.", "Three hundred trees out there. I counted twice.", "The tavern fire's lit. Always is.", "The Wick is the first lamp lit and the last one out.", "Sixteen steps up my tower. I counted twice.")
