bed_lines = PackedStringArray("The lamps are out. Time an old man slept.", "Daylight. Bedtime for a lamplighter.")
wake_lines = PackedStringArray("Evening coming. The lamps won't light themselves.", "Hm. Up again. Dusk soon.")
greet_lines = PackedStringArray("Ah, {n}.", "Good {tod}, {n}.", "Slow down, {n}, the world isn't going anywhere.")
reply_lines = PackedStringArray("Kids these days.", "Hm. Indeed.", "I've heard stranger.", "Quite.")
answer_lines = PackedStringArray("The lamp knows. Ask the lamp.", "Patience will tell you.", "Hmm. Perhaps.")
