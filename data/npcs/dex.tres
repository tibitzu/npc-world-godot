lines = PackedStringArray("Night watch. Best watch.", "Dax snores. I can hear it from the square.", "Quiet out there. Too quiet. No, it's fine.", "The lamps and me, we keep the dark honest.", "I'm the handsome one.", "Halt! Oh, it's you.")
sleep_hour = 10.0
wake_hour = 18.0
bed_lines = PackedStringArray("Watch handed over. Wake me if there's a dragon.", "Sun's up. Guard's down.")
wake_lines = PackedStringArray("Night watch, on duty.", "Evening. Dax, go to bed.")
